# Development only. Never place production secrets or provider credentials in this file.
ENVIRONMENT=development
LOG_LEVEL=INFO
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://workflow:workflow@postgres:5432/workflow
AWS_REGION=ap-northeast-1
RAW_BUCKET=workflow-helper-raw-dev
PROCESSED_BUCKET=workflow-helper-processed-dev
RAW_RETENTION_DAYS=14

# Required only for the explicitly invoked synthetic dev server.  Keep these
# unset in this example; provide fresh synthetic values at runtime.
WORKFLOW_DEV_DATA_DIR=
WORKFLOW_DEV_CAPTURE_PROOF=
WORKFLOW_DEV_WORKER_PROOF=
WORKFLOW_DEV_REVIEWER_PROOF=
WORKFLOW_DEV_REVIEWER_SESSION=
WORKFLOW_DEV_REVIEWER_CSRF=
