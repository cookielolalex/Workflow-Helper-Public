{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-helper.local/contracts/label.schema.json",
  "title": "Workflow label",
  "type": "object",
  "additionalProperties": false,
  "required": ["label_id", "category", "provenance", "confidence", "approval_status"],
  "properties": {
    "label_id": { "type": "string", "format": "uuid" },
    "category": {
      "enum": [
        "drawing_setup",
        "geometry_creation",
        "geometry_modification",
        "dimensioning",
        "hole_cutout_placement",
        "component_placement",
        "annotation",
        "layer_property_change",
        "reuse_prior_geometry",
        "correction_rework",
        "checking_verification",
        "export_plot",
        "uncertain"
      ]
    },
    "provenance": { "enum": ["observed", "deterministic", "ai_inferred", "human_supplied"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "approval_status": { "enum": ["unreviewed", "approved", "rejected", "needs_changes"] },
    "start_offset_seconds": { "type": ["number", "null"], "minimum": 0 },
    "end_offset_seconds": { "type": ["number", "null"], "minimum": 0 },
    "reviewer_note": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
