{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-helper.local/contracts/candidate-skill.schema.json",
  "title": "Candidate reusable CAD workflow skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "name",
    "description",
    "trigger",
    "preconditions",
    "inputs",
    "relevant_drawing_state",
    "ordered_actions",
    "parameters",
    "constraints",
    "expected_result",
    "validation_checks",
    "known_exceptions",
    "supporting_examples",
    "confidence",
    "provenance",
    "approval_status",
    "human_approval_evidence"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "skill_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "trigger": { "$ref": "#/$defs/trigger" },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundedText" }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/input" }
    },
    "relevant_drawing_state": { "$ref": "#/$defs/drawingState" },
    "ordered_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/action" }
    },
    "parameters": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/boundedText" }
    },
    "expected_result": { "$ref": "#/$defs/expectedResult" },
    "validation_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/validationCheck" }
    },
    "known_exceptions": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/knownException" }
    },
    "supporting_examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/supportingExample" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "provenance": {
      "enum": ["observed", "deterministic", "ai_inferred", "human_supplied"]
    },
    "approval_status": {
      "enum": ["unreviewed", "approved", "rejected", "needs_changes"]
    },
    "human_approval_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/humanApprovalEvidence" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "approval_status": { "const": "approved" } },
        "required": ["approval_status"]
      },
      "then": {
        "properties": {
          "human_approval_evidence": { "$ref": "#/$defs/humanApprovalEvidence" }
        }
      }
    }
  ],
  "$defs": {
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "signals"],
      "properties": {
        "condition": { "$ref": "#/$defs/boundedText" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedText" }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "description", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": {
          "enum": ["drawing_state", "artifact", "measurement", "parameter", "instruction"]
        },
        "description": { "$ref": "#/$defs/boundedText" },
        "required": { "type": "boolean" }
      }
    },
    "drawingState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "required_conditions", "excluded_conditions"],
      "properties": {
        "description": { "$ref": "#/$defs/boundedText" },
        "required_conditions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedText" }
        },
        "excluded_conditions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedText" }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "instruction", "parameter_names"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 256 },
        "instruction": { "$ref": "#/$defs/boundedText" },
        "parameter_names": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit", "provenance"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": ["string", "number", "integer", "boolean"], "maxLength": 512 },
        "unit": { "type": ["string", "null"], "maxLength": 64 },
        "provenance": {
          "enum": ["observed", "deterministic", "ai_inferred", "human_supplied"]
        }
      }
    },
    "expectedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "observable_outcomes"],
      "properties": {
        "description": { "$ref": "#/$defs/boundedText" },
        "observable_outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/boundedText" }
        }
      }
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "success_criterion"],
      "properties": {
        "description": { "$ref": "#/$defs/boundedText" },
        "success_criterion": { "$ref": "#/$defs/boundedText" }
      }
    },
    "knownException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "handling"],
      "properties": {
        "condition": { "$ref": "#/$defs/boundedText" },
        "handling": { "$ref": "#/$defs/boundedText" }
      }
    },
    "supportingExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "summary", "artifact_references"],
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "summary": { "$ref": "#/$defs/boundedText" },
        "artifact_references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "artifact-ref.schema.json" }
        }
      }
    },
    "humanApprovalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "decision_event_id", "decided_at", "approval_basis"],
      "properties": {
        "reviewer_id": {
          "type": "string",
          "pattern": "^reviewer_[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "decision_event_id": { "type": "string", "format": "uuid" },
        "decided_at": { "type": "string", "format": "date-time" },
        "approval_basis": { "$ref": "#/$defs/boundedText" }
      }
    }
  }
}
